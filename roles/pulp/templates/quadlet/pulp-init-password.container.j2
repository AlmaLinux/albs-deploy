# {{ ansible_managed }}
# One-shot: seed the Pulp admin (superuser) password on a FRESH install.
#
# Ordered After=pulp-migration because the auth tables must exist before a
# password can be set — the compose rendering only gated this on postgres being
# healthy, which is a latent race on a first bring-up.
#
# Not rendered when pulp_set_init_password is false (an existing deployment,
# where running this would reset the current admin's password).
[Unit]
Description=Pulp initial admin password (one-shot)
Requires=pulp-migration.service
After=pulp-migration.service
{% if pulp_quadlet_runtime_mounts %}
RequiresMountsFor={{ pulp_quadlet_runtime_mounts | join(' ') }}
{% endif %}

[Container]
ContainerName=pulp-init-password
Image={{ pulp_runtime_image }}
Network={{ pulp_quadlet_network_name }}.network
Exec=set_init_password.sh
Environment=PULP_DEFAULT_ADMIN_PASSWORD={{ pulp_admin_password }}
{% for vol in pulp_quadlet_runtime_volumes %}
Volume={{ vol }}
{% endfor %}
LogDriver={{ pulp_log_driver }}
PodmanArgs=--user {{ pulp_run_user }}{% if pulp_log_driver == 'journald' %} --log-opt tag=pulp_init_password{% endif %}


[Service]
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
